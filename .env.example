# Copie para .env e ajuste.
# Desenvolvimento: rode `npm run db:start` e use a URL abaixo.
# Produção (fase 7): a URL do Neon.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Banco descartável do `prisma migrate dev` (o shadow do `prisma dev`).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Produção (Vercel + Neon), configurado no painel da Vercel, NÃO aqui:
#   DATABASE_URL = string "Pooled connection" do Neon (o site usa esta)
#   DIRECT_URL   = string "Direct connection" do Neon (as migrations usam esta)
